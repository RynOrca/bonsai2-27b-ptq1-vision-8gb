+int main() {
+    try {
+        full_page_fork();
+        partial_tail_fork();
+        abort_fork();
+        staged_tail_fork();
+        stale_host_rejected();
+        insufficient_logical_coverage_rejected();
+        physical_exhaustion_rejected();
+        default_resident_only();
+        aliased_full_page_partial_tail();
+        dual_pool_consumed_suffix_lifetime();
+        std::cout << "PASS: Host-backed prefix fork full/partial/abort/staged/stale/capacity/default/alias-tail/dual-pool\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "FAIL: " << error.what() << '\n';
+        return 1;
+    }
+}
