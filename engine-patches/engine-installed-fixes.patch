+void dual_pool_consumed_suffix_lifetime() {
+    for (const bool staged : {false, true}) {
+        Fixture main;
+        Fixture backend;
+        const auto main_source = main.source(900);
+        const auto backend_source = backend.source(901);
+        // Mirror prepare_consumed_source: trim only discarded suffix membership, without
+        // changing the kept partial page's canonical coverage before its COW completes.
+        main.addresses.truncate_inactive_prefix(main_source, 775);
+        backend.addresses.truncate_inactive_prefix(backend_source, 776);
+        main.addresses.set_checkpoint_requirement(main_source, 775);
+        backend.addresses.set_checkpoint_requirement(backend_source, 776);
+        (void)main.extents.release_unreferenced();
+        (void)backend.extents.release_unreferenced();
+        const auto main_child = *main.addresses.create_inactive();
+        const auto backend_child = *backend.addresses.create_inactive();
+        auto main_fork = main.fork(main_source, main_child, 775, 16, staged);
+        auto backend_fork = backend.fork(backend_source, backend_child, 776, 16, staged);
+        const auto complete_copy = [&](Fixture& f, kv::KVAddressSpaceHandle source,
+                                       kv::KVPrefixForkReservation& fork) {
+            f.physical.copy_page(f.addresses.prefix_fork_tail_source(fork),
+                                 f.addresses.prefix_fork_tail_destination(fork),
+                                 f.device.transfer_stream);
+            CUDA_CHECK(cudaStreamSynchronize(f.device.transfer_stream));
+            if (staged) {
+                const auto tail = f.addresses.logical_page(source, 12);
+                f.addresses.settle_prefix_fork_tail_source(fork);
+                check(f.pages.drop_device_replica(tail), "dual-pool staged tail demotion");
+                f.addresses.complete_prefix_fork_after_tail_release(fork);
+            }
+        };
+        complete_copy(main, main_source, main_fork);
+        complete_copy(backend, backend_source, backend_fork);
+        const auto backend_reserved = backend.physical.reserved_pages();
+        main.addresses.commit_prefix_fork(std::move(main_fork), main.device.stream);
+        check(main.addresses.release(main_source), "consumed main source releases after commit");
+        (void)main.extents.release_unreferenced();
+        check(backend.physical.reserved_pages() == backend_reserved &&
+                  !backend.addresses.can_release(backend_source),
+              "main commit/source release cannot alter backend reservations or source pins");
+        backend.addresses.commit_prefix_fork(std::move(backend_fork), backend.device.stream);
+        check(backend.addresses.release(backend_source), "consumed backend source releases after commit");
+        (void)backend.extents.release_unreferenced();
+        for (auto item : {std::pair{&main, main_child}, std::pair{&backend, backend_child}}) {
+            check(item.first->addresses.release_after_deactivate(item.second), "dual-pool child release");
+            (void)item.first->extents.release_unreferenced();
+            check(item.first->physical.allocated_pages() == 0 &&
+                      item.first->physical.reserved_pages() == 0 && item.first->pages.occupied() == 0,
+                  "dual-pool consumed lifecycle leaves no resources");
+        }
+    }
+}
+}
