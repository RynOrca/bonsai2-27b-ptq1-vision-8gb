+void aliased_full_page_partial_tail() {
+    Fixture f;
+    const auto source = f.source(64);
+    const auto alias = *f.addresses.create_inactive();
+    auto alias_fork = f.addresses.prepare_prefix_fork(source, alias, 64, 1, 1);
+    f.addresses.commit_prefix_fork(std::move(alias_fork), f.device.stream);
+    f.device.synchronize();
+    f.addresses.deactivate(alias);
+    f.addresses.set_checkpoint_requirement(alias, 64);
+    const auto shared = f.addresses.logical_page(source, 0);
+    const auto other_alias = f.addresses.logical_page(alias, 0);
+    check(shared == other_alias && f.pages.address_references(shared) == 2 &&
+              f.pages.committed_columns(shared) == 64 && f.pages.host_replica_current(shared),
+          "two inactive owners share a complete Host-backed logical page");
+    const auto before = f.bytes(shared);
+    const auto epoch = f.pages.content_epoch(shared);
+    const auto child = *f.addresses.create_inactive();
+    auto fork = f.fork(source, child, 3, 1);
+    check(f.pages.source_pins(shared) == 1 && f.pages.source_pins(other_alias) == 1 &&
+              !f.pages.drop_device_replica(other_alias) && !f.pages.drop_device_replica(shared),
+          "partial-tail source pin protects every alias of the same logical page");
+    check(!f.addresses.can_release(source) && !f.addresses.can_release(alias),
+          "the pin protects both parent owner lifetimes");
+    f.physical.copy_page(f.addresses.prefix_fork_tail_source(fork),
+                        f.addresses.prefix_fork_tail_destination(fork), f.device.transfer_stream);
+    CUDA_CHECK(cudaStreamSynchronize(f.device.transfer_stream));
+    f.addresses.commit_prefix_fork(std::move(fork), f.device.stream);
+    const auto child_tail = f.addresses.logical_page(child, 0);
+    check(child_tail != shared && f.pages.committed_columns(child_tail) == 3 &&
+              f.pages.source_pins(shared) == 0 && f.pages.can_drop_device_replica(shared),
+          "COW creates a private three-column tail and releases the shared pin");
+    auto appended = f.host.allocate(f.host_layout, 1);
+    check(appended.has_value(), "alias append payload allocation");
+    auto writable = f.host.writable_view(*appended);
+    std::memcpy(writable.data(), before.data(), before.size());
+    writable.data()[3 * 8 * sizeof(std::uint16_t)] = std::byte{0x66};
+    const std::array target{f.pages.physical(child_tail)};
+    f.physical.copy_from_host(writable, target, f.device.stream);
+    f.device.synchronize();
+    f.addresses.commit_frontier(child, 4);
+    check(f.bytes(child_tail) != before && f.bytes(shared) == before &&
+              f.bytes(other_alias) == before && f.pages.committed_columns(shared) == 64 &&
+              f.pages.committed_columns(other_alias) == 64 &&
+              f.pages.content_epoch(shared) == epoch && f.pages.content_epoch(other_alias) == epoch &&
+              f.addresses.committed_frontier(source) == 64 &&
+              f.addresses.committed_frontier(alias) == 64,
+          "child rewrite leaves both inactive parents' payload, coverage and epoch intact");
+    check(f.addresses.release(alias), "second inactive parent releases independently");
+    f.cleanup(source, child);
+}
