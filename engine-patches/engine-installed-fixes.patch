+#include "core/device.h"
+#include "models/qwen3_5/program/storage/host_kv_store.h"
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+namespace kv = ninfer::models::qwen3_5::detail;
+void check(bool value, const char* message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+struct Fixture {
+    ninfer::DeviceContext device{0};
+    ninfer::LayoutBuilder builder;
+    ninfer::DeviceKVPagePoolLayout page_layout = ninfer::plan_device_kv_page_pool(
+        builder, {.page_group_count = 8, .allow_logical_reservation = true,
+                  .geometry = {.page_tokens = 64,
+                    .device_plane_order = ninfer::PagedKVPlaneOrder::PageMajor,
+                    .planes = {{.dtype = ninfer::DType::BF16,
+                                .leading_extent = 8, .head_extent = 2}}}});
+    ninfer::KVExecutionTableLayout table_layout = ninfer::plan_kv_execution_tables(
+        builder, {.logical_page_capacity = 16, .table_rows = 2});
+    ninfer::DeviceArena arena{builder.finish(256)};
+    ninfer::DeviceSpan backing{arena.base(), arena.capacity()};
+    ninfer::DeviceKVPagePool physical{backing, page_layout};
+    ninfer::KVExecutionTablePool tables{backing, table_layout, physical};
+    ninfer::HostKVPageLayout host_layout = ninfer::plan_host_kv_page_layout(physical.geometry());
+    std::array<ninfer::HostKVPageLayout, 1> layouts{host_layout};
+    ninfer::HostKVArena host{host_layout.page_stride * 32, layouts};
+    kv::LogicalKVPageStore pages{physical, 48};
+    kv::HostKVExtentStore extents{host, 32};
+    kv::KVAddressSpaceStore addresses{pages, tables, 6, 16};
+
+    void backup(kv::LogicalKVPageHandle page) {
+        const std::array membership{page};
+        auto reservation = extents.prepare(pages, membership);
+        check(reservation.has_value(), "Host backup reservation");
+        physical.copy_to_host(extents.device_sources(*reservation),
+                              extents.writable_view(*reservation), device.transfer_stream);
+        CUDA_CHECK(cudaStreamSynchronize(device.transfer_stream));
+        check(extents.publish(std::move(*reservation)).has_value(), "Host backup publication");
+    }
+    kv::KVAddressSpaceHandle source(std::uint32_t frontier) {
+        auto address = addresses.create_active(16, 0, {});
+        check(address.has_value(), "source allocation");
+        const std::uint32_t count = (frontier + 63) / 64;
+        for (std::uint32_t i = 0; i < count; ++i) {
+            if (i != 0) {
+                auto activation = addresses.prepare_activation(*address, 16, 0, {}, true);
+                addresses.commit_activation(std::move(activation), device.stream);
+            }
+            const auto end = std::min(frontier, (i + 1) * 64);
+            addresses.ensure_mapped_to_tokens(*address, end, device.stream);
+            auto logical = addresses.logical_page(*address, i);
+            auto payload = host.allocate(host_layout, 1);
+            check(payload.has_value(), "test payload allocation");
+            auto writable = host.writable_view(*payload);
+            std::memset(writable.data(), static_cast<int>(i + 1), host_layout.page_stride);
+            const std::array target{pages.physical(logical)};
+            physical.copy_from_host(writable, target, device.stream);
+            device.synchronize();
+            addresses.commit_frontier(*address, end);
+            addresses.deactivate(*address);
+            backup(logical);
+            // Keep a small resident suffix, as the production Host-backed ring does.
+            if (i >= 3) {
+                check(pages.drop_device_replica(addresses.logical_page(*address, i - 3)),
+                      "source ring demotion");
+            }
+        }
+        addresses.set_checkpoint_requirement(*address, frontier);
+        return *address;
+    }
+    auto fork(kv::KVAddressSpaceHandle source, kv::KVAddressSpaceHandle destination,
+              std::uint32_t frontier, std::uint32_t entitlement = 16, bool staged = false) {
+#ifdef HOST_AWARE_PREFIX_FORK
+        return addresses.prepare_prefix_fork(source, destination, frontier, entitlement, 1,
+                                             staged, true);
+#else
+        return addresses.prepare_prefix_fork(source, destination, frontier, entitlement, 1, staged);
+#endif
+    }
+    std::vector<std::byte> bytes(kv::LogicalKVPageHandle page) {
+        auto payload = host.allocate(host_layout, 1);
+        check(payload.has_value(), "test readback allocation");
+        auto view = host.writable_view(*payload);
+        const std::array source{pages.physical(page)};
+        physical.copy_to_host(source, view, device.stream);
+        device.synchronize();
+        return {view.data(), view.data() + host_layout.page_stride};
+    }
+    void cleanup(kv::KVAddressSpaceHandle source, kv::KVAddressSpaceHandle destination) {
+        check(addresses.release_after_deactivate(destination), "child release");
+        check(addresses.release(source), "parent release");
+        (void)extents.release_unreferenced();
+        check(pages.occupied() == 0 && physical.allocated_pages() == 0 &&
+                  physical.reserved_pages() == 0, "all logical/physical/reservation resources freed");
+    }
+};
+
+void full_page_fork() {
+    Fixture f;
+    const auto source = f.source(12 * 64);
+    const auto child = *f.addresses.create_inactive();
+    const auto row = f.tables.matrix().slice(1, 1, 1).view({16});
+    // DeviceContext uses non-blocking streams: default-stream cudaMemset is not ordered
+    // before commit's table copies. Initialize the sentinel on that same compute stream.
+    CUDA_CHECK(cudaMemsetAsync(row.data, 0xff, 16 * sizeof(std::int32_t), f.device.stream));
+    auto fork = f.fork(source, child, 12 * 64);
+    check(!f.addresses.can_release(source), "transaction pins protect the parent lifecycle");
+    for (unsigned i = 0; i < 12; ++i) {
+        check(f.pages.source_pins(f.addresses.logical_page(source, i)) == 1, "fork pins all sources");
+    }
+    f.addresses.commit_prefix_fork(std::move(fork), f.device.stream);
+    f.device.synchronize();
+    check(f.addresses.committed_frontier(child) == 768 && f.addresses.active(child),
+          "Host-backed child publishes exact frontier");
+    check(f.physical.allocated_pages() == 3 && f.physical.reserved_pages() == 13,
+          "Host sharing allocates no Device pages and reserves missing plus growth");
+    std::array<std::int32_t, 16> entries;
+    CUDA_CHECK(cudaMemcpy(entries.data(), row.data, sizeof(entries), cudaMemcpyDeviceToHost));
+    for (unsigned i = 0; i < 12; ++i) {
+        auto page = f.addresses.logical_page(source, i);
+        check(page == f.addresses.logical_page(child, i) && f.pages.address_references(page) == 2 &&
+                  f.pages.source_pins(page) == 0 && f.pages.writer_references(page) == 0,
+              "full pages share immutable logical identities");
+        check(f.pages.active_address_references(page) == (f.pages.device_resident(page) ? 1U : 0U),
+              "only resident pages hold active references");
+        check(f.pages.device_resident(page) ? entries[i] >= 0 && entries[i] < 8 : entries[i] == -1,
+              "execution row publishes only resident runs");
+    }
+    // A retained parent cannot disappear when the child is activated.
+    check(f.addresses.can_release(source), "retained parent remains independently releasable");
+    f.cleanup(source, child);
+}
+
+void partial_tail_fork() {
+    Fixture f;
+    const auto source = f.source(12 * 64 + 7);
+    const auto child = *f.addresses.create_inactive();
+    const auto tail = f.addresses.logical_page(source, 12);
+    const auto before = f.bytes(tail);
+    const auto epoch = f.pages.content_epoch(tail);
+    auto fork = f.fork(source, child, 775);
+    f.physical.copy_page(f.addresses.prefix_fork_tail_source(fork),
+                        f.addresses.prefix_fork_tail_destination(fork), f.device.transfer_stream);
+    CUDA_CHECK(cudaStreamSynchronize(f.device.transfer_stream));
+    f.addresses.commit_prefix_fork(std::move(fork), f.device.stream);
+    const auto child_tail = f.addresses.logical_page(child, 12);
+    check(child_tail != tail && f.bytes(child_tail) == before, "partial tail is a true payload COW");
+    f.addresses.ensure_mapped_to_tokens(child, 776, f.device.stream);
+    auto appended = f.host.allocate(f.host_layout, 1);
+    check(appended.has_value(), "append test payload allocation");
+    auto writable = f.host.writable_view(*appended);
+    std::memcpy(writable.data(), before.data(), before.size());
+    // Host layout for this single BF16 plane is [8,64,2]; change token column 7.
+    writable.data()[7 * 8 * sizeof(std::uint16_t)] = std::byte{0x55};
+    const std::array target{f.pages.physical(child_tail)};
+    f.physical.copy_from_host(writable, target, f.device.stream);
+    f.device.synchronize();
+    f.addresses.commit_frontier(child, 776);
+    check(f.pages.committed_columns(child_tail) == 8 && f.pages.writer_references(child_tail) == 1,
+          "private child tail appends");
+    check(f.pages.committed_columns(tail) == 7 && f.pages.content_epoch(tail) == epoch &&
+              f.bytes(tail) == before && f.bytes(child_tail) != before &&
+              f.addresses.committed_frontier(source) == 775,
+          "parent payload, epoch and frontier survive child append");
+    f.cleanup(source, child);
+}
+
+void abort_fork() {
+    Fixture f;
+    const auto source = f.source(775);
+    const auto child = *f.addresses.create_inactive();
+    const auto allocated = f.physical.allocated_pages();
+    {
+        auto fork = f.fork(source, child, 775);
+        check(f.physical.allocated_pages() == allocated + 1, "abort fixture has private COW page");
+        f.addresses.abort_prefix_fork(fork);
+        check(f.physical.allocated_pages() == allocated && f.physical.reserved_pages() == 0,
+              "explicit abort immediately releases pages and reservations");
+        auto row = f.tables.acquire(1);
+        check(row.valid(), "explicit abort immediately releases execution row");
+    }
+    check(f.physical.allocated_pages() == allocated && f.physical.reserved_pages() == 0,
+          "abort frees COW and reservations");
+    for (unsigned i = 0; i < 13; ++i) {
+        auto page = f.addresses.logical_page(source, i);
+        check(f.pages.source_pins(page) == 0 && f.pages.address_references(page) == 1,
+              "abort restores source pins and references");
+    }
+    check(!f.addresses.active(child) && f.addresses.mapped_pages(child) == 0,
+          "abort leaves child unpublished");
+    f.cleanup(source, child);
+}
+
+void staged_tail_fork() {
+    Fixture f;
+    const auto source = f.source(775);
+    const auto child = *f.addresses.create_inactive();
+    const auto tail = f.addresses.logical_page(source, 12);
+    const auto before = f.bytes(tail);
+    auto fork = f.fork(source, child, 775, 16, true);
+    f.physical.copy_page(f.addresses.prefix_fork_tail_source(fork),
+                        f.addresses.prefix_fork_tail_destination(fork), f.device.transfer_stream);
+    CUDA_CHECK(cudaStreamSynchronize(f.device.transfer_stream));
+    f.addresses.settle_prefix_fork_tail_source(fork);
+    check(f.pages.drop_device_replica(tail), "staged source tail demotes after copy");
+    f.addresses.complete_prefix_fork_after_tail_release(fork);
+    f.addresses.commit_prefix_fork(std::move(fork), f.device.stream);
+    check(f.bytes(f.addresses.logical_page(child, 12)) == before &&
+              !f.pages.device_resident(tail) && f.pages.host_replica_current(tail),
+          "staged fork preserves Host parent and independent Device child tail");
+    check(f.physical.reserved_pages() == 13, "staged settlement retains missing plus growth budget");
+    f.cleanup(source, child);
+}
+
+void stale_host_rejected() {
+    Fixture f;
+    const auto source = f.source(768);
+    const auto child = *f.addresses.create_inactive();
+    const auto first = f.addresses.logical_page(source, 0);
+    // Fault injection into a published replica tests validation independently of the Host
+    // publisher, which correctly refuses to create stale metadata through its public API.
+    auto& replica = const_cast<kv::HostKVPageReplica&>(f.pages.host_replica(first));
+    const auto epoch = replica.content_epoch;
+    const auto columns = replica.committed_columns;
+    auto rejected_without_mutation = [&] {
+        bool rejected = false;
+        try { auto fork = f.fork(source, child, 768); }
+        catch (const ninfer::ContextCacheExhausted&) {
+            throw std::runtime_error("stale Host epoch/coverage must not be classified as capacity");
+        }
+        catch (const std::logic_error&) { rejected = true; }
+        check(rejected && f.physical.reserved_pages() == 0 &&
+                  f.pages.source_pins(first) == 0 && f.addresses.mapped_pages(child) == 0,
+              "invalid Host replica rejected without mutation");
+    };
+    replica.content_epoch = epoch + 1;
+    rejected_without_mutation();
+    replica.content_epoch = epoch;
+    replica.committed_columns = columns - 1;
+    rejected_without_mutation();
+    replica.committed_columns = columns;
+    {
+        auto fork = f.fork(source, child, 768);
+        replica.content_epoch = epoch + 1;
+        bool rejected = false;
+        try { f.addresses.commit_prefix_fork(std::move(fork), f.device.stream); }
+        catch (const std::logic_error&) { rejected = true; }
+        check(rejected && !f.addresses.active(child), "commit revalidates Host epoch");
+        replica.content_epoch = epoch;
+    }
+    check(f.pages.source_pins(first) == 0 && f.physical.reserved_pages() == 0,
+          "failed commit RAII abort restores pins and reservations");
+    f.cleanup(source, child);
+}
+
+void insufficient_logical_coverage_rejected() {
+    Fixture f;
+    const auto source = f.source(64);
+    const auto child = *f.addresses.create_inactive();
+    const auto page = f.addresses.logical_page(source, 0);
+    f.addresses.set_checkpoint_requirement(source, 0);
+    const std::array membership{page};
+    check(f.extents.release_page_replicas(f.pages, membership), "remove Host backup for fault injection");
+    // Deliberately leave the owner's frontier inconsistent with its logical page coverage.
+    // The fork must surface that invariant violation, rather than turn it into HTTP 429.
+    f.pages.set_writer(page, true);
+    f.pages.destructive_truncate(page, 3);
+    f.pages.set_writer(page, false);
+    bool rejected = false;
+    try { auto fork = f.fork(source, child, 64); }
+    catch (const ninfer::ContextCacheExhausted&) {
+        throw std::runtime_error("insufficient logical coverage must not be classified as capacity");
+    }
+    catch (const std::logic_error&) { rejected = true; }
+    check(rejected && f.pages.source_pins(page) == 0 && f.physical.reserved_pages() == 0 &&
+              !f.addresses.active(child), "coverage invariant rejects before mutation");
+    f.cleanup(source, child);
+}
+
+void physical_exhaustion_rejected() {
+    Fixture f;
+    const auto source = f.source(775);
+    const auto child = *f.addresses.create_inactive();
+    const auto filler = *f.addresses.create_active(5, 0, {});
+    f.addresses.ensure_mapped_to_tokens(filler, 5 * 64, f.device.stream);
+    check(f.physical.allocated_pages() == 8, "fixture fills physical pool");
+    bool rejected = false;
+    try { auto fork = f.fork(source, child, 775); }
+    catch (const ninfer::ContextCacheExhausted&) { rejected = true; }
+    check(rejected && !f.addresses.active(child) && f.physical.allocated_pages() == 8 &&
+              f.physical.reserved_pages() == 0,
+          "Host-aware fork cannot fake success without a physical COW destination");
+    check(f.addresses.release_after_deactivate(filler), "filler releases");
+    f.cleanup(source, child);
+}
