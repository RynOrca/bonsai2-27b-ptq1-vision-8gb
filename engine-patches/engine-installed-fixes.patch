diff --git a/tools/generate_device_profiles_builtin.py b/tools/generate_device_profiles_builtin.py
new file mode 100644
index 0000000..95504bc
--- /dev/null
+++ b/tools/generate_device_profiles_builtin.py
@@ -0,0 +1,95 @@
+"""Emit the embedded device-route-profile JSON as several C++ string literals.
+
+WHY: `src/runtime/engine/device_profiles_builtin.cpp.in` splices
+`device_profiles.json` (30,566 bytes) into a single raw string literal. MSVC
+rejects such a literal with
+
+    device_profiles_builtin.cpp(217): error C2026: string too big, trailing
+    characters truncated
+
+because its per-literal budget is far below the JSON size. The reference build
+used CUDA 12.8, whose supported MSVC releases accepted the single literal; the
+toolchain available here is MSVC 19.44 with CUDA 13.4, which does not.
+
+This script performs the same substitution but splits the payload into adjacent
+string literals of at most CHUNK bytes, cut at newline boundaries so the
+generated C++ stays valid without escaping. Adjacent literals concatenate at
+translation time, so the value returned is byte-identical to the input file.
+
+Output path and result are interchangeable with the CMake-generated file, so
+nothing else in the build changes.
+"""
+from __future__ import annotations
+
+import argparse
+import pathlib
+import sys
+
+# Keep well below the compiler's per-literal budget, which is documented in the
+# low tens of thousands of bytes but has shifted between MSVC releases. Cutting
+# at or under this bound is safe for every release in the supported range.
+CHUNK = 12000
+
+HEADER = '''#include "runtime/engine/device_profiles_builtin.h"
+
+namespace ninfer::runtime {
+
+// Generated from src/runtime/engine/device_profiles.json.
+// Split into adjacent string literals by tools/generate_device_profiles_builtin.py
+// because the whole 30 KB payload in one literal exceeds the MSVC per-literal
+// budget (C2026). Adjacent literals concatenate, so the returned view is
+// byte-identical to the JSON source.
+std::string_view compiled_device_route_profiles_json() {
+    return
+'''
+
+FOOTER = ''';
+}
+
+} // namespace ninfer::runtime
+'''
+
+
+def split_payload(text: str, limit: int) -> list[str]:
+    """Cut `text` into pieces of at most `limit` characters, preferring newlines."""
+    pieces: list[str] = []
+    start = 0
+    length = len(text)
+    while start < length:
+        end = min(start + limit, length)
+        if end < length:
+            newline = text.rfind("\n", start, end)
+            if newline != -1 and newline + 1 > start:
+                end = newline + 1
+        pieces.append(text[start:end])
+        start = end
+    return pieces
+
+
+def render_chunk(piece: str) -> str:
+    """One C++ raw string literal holding `piece`, including its newlines."""
+    if "(/" in piece or ")/" in piece:
+        # Raw-string delimiters must not appear inside the payload.
+        raise SystemExit("payload contains a raw-string delimiter sequence")
+    return f'        R"ninfer_json({piece})ninfer_json"\n'
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--json", type=pathlib.Path, required=True)
+    parser.add_argument("--out", type=pathlib.Path, required=True)
+    args = parser.parse_args()
+
+    text = args.json.read_text(encoding="utf-8")
+    pieces = split_payload(text, CHUNK)
+
+    body = "".join(render_chunk(piece) for piece in pieces)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(HEADER + body + FOOTER, encoding="utf-8")
+
+    print(f"wrote {args.out} ({len(pieces)} literals, {len(text)} bytes of JSON)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
