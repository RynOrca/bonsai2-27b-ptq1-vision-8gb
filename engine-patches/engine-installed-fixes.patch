+void default_resident_only() {
+    Fixture f;
+    const auto source = f.source(128);
+    const auto child = *f.addresses.create_inactive();
+    auto fork = f.addresses.prepare_prefix_fork(source, child, 128, 3, 1);
+    f.addresses.commit_prefix_fork(std::move(fork), f.device.stream);
+    check(f.addresses.entitlement(child) == 3 && f.physical.reserved_pages() == 1,
+          "default resident-only fork preserves entitlement");
+    f.cleanup(source, child);
+
+    const auto host_source = f.source(768);
+    const auto host_child = *f.addresses.create_inactive();
+    bool rejected = false;
+    try { auto unchanged = f.addresses.prepare_prefix_fork(host_source, host_child, 768, 16, 1); }
+    catch (const ninfer::ContextCacheExhausted&) { rejected = true; }
+    check(rejected, "default resident-only API still rejects Host-only pages");
+    f.cleanup(host_source, host_child);
+}
