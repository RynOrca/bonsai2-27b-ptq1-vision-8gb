+# FindFFMPEG.cmake — locate an unpacked FFmpeg SDK for NInfer on native Windows.
+#
+# WHY THIS REPLACES THE vcpkg BRIDGE: the tracked module of the same name resolves
+# FFmpeg only through a vcpkg triplet tree and hard-codes the pre-8.x artifact
+# names (`lib/swscale.lib`). FFmpeg 8.x ships versioned names on Windows
+# (`swscale-9.lib`, `avcodec-62.dll`, ...), so that module reports
+# "missing swscale.lib in .../lib" even when a complete SDK is present. This host
+# has no vcpkg; it has the SDK unpacked at C:\ffmpeg.
+#
+# It sets exactly what cmake/Dependencies.cmake consumes:
+#   FFMPEG_INCLUDE_DIRS, FFMPEG_LIBRARY_DIRS, FFMPEG_LIBRARIES, FFMPEG_VCPKG_TREE
+# Point FFMPEG_DIR, FFMPEG_ROOT or CMAKE_PREFIX_PATH at the SDK root (the directory
+# holding include/libavcodec/avcodec.h and lib/).
+#
+# The ABI floors mirror the Linux branch of Dependencies.cmake, because
+# src/media/decode/decode.cpp is written against them:
+#   libavformat >= 60, libavcodec >= 60, libavutil >= 58, libswscale >= 7
+
+include(FindPackageHandleStandardArgs)
+
+set(_ffmpeg_hints "")
+foreach(_hint IN ITEMS "${FFMPEG_DIR}" "${FFMPEG_ROOT}" "${FFMPEG_VCPKG_TREE}"
+                        "$ENV{FFMPEG_DIR}" "$ENV{FFMPEG_ROOT}")
+  if(_hint)
+    list(APPEND _ffmpeg_hints "${_hint}")
+  endif()
+endforeach()
+
+find_path(FFMPEG_INCLUDE_DIR
+  NAMES libavcodec/avcodec.h
+  HINTS ${_ffmpeg_hints}
+  PATH_SUFFIXES include)
+
+# FFmpeg 8.x versions its Windows import libraries, so match the base name and let
+# CMake pick whichever variant the SDK ships.
+foreach(_lib IN ITEMS avformat avcodec avutil swscale swresample)
+  string(TOUPPER "${_lib}" _lib_upper)
+  find_library(FFMPEG_${_lib_upper}_LIBRARY
+    NAMES ${_lib}
+    HINTS ${_ffmpeg_hints}
+    PATH_SUFFIXES lib)
+endforeach()
+
+find_package_handle_standard_args(FFMPEG
+  REQUIRED_VARS FFMPEG_INCLUDE_DIR
+                FFMPEG_AVFORMAT_LIBRARY
+                FFMPEG_AVCODEC_LIBRARY
+                FFMPEG_AVUTIL_LIBRARY
+                FFMPEG_SWSCALE_LIBRARY
+  FAIL_MESSAGE "FFmpeg SDK not found. Set FFMPEG_DIR to the SDK root (the directory that contains include/libavcodec/avcodec.h and lib/).")
+
+if(NOT FFMPEG_FOUND)
+  return()
+endif()
+
+# ABI floors, read from the SDK's own version headers.
+function(_ninfer_ffmpeg_require_major header macro name floor)
+  if(NOT EXISTS "${header}")
+    return()
+  endif()
+  file(STRINGS "${header}" _match REGEX "^#define ${macro} +[0-9]+")
+  if(_match MATCHES "${macro} +([0-9]+)")
+    if(CMAKE_MATCH_1 LESS floor)
+      message(FATAL_ERROR
+        "FFmpeg ${name} major ${CMAKE_MATCH_1} is older than the required ${floor} "
+        "(from ${header}); src/media/decode/decode.cpp targets the newer ABI.")
+    endif()
+  endif()
+endfunction()
+
+_ninfer_ffmpeg_require_major("${FFMPEG_INCLUDE_DIR}/libavformat/version_major.h"
+                             "LIBAVFORMAT_VERSION_MAJOR" "libavformat" 60)
+_ninfer_ffmpeg_require_major("${FFMPEG_INCLUDE_DIR}/libavcodec/version_major.h"
+                             "LIBAVCODEC_VERSION_MAJOR" "libavcodec" 60)
+_ninfer_ffmpeg_require_major("${FFMPEG_INCLUDE_DIR}/libavutil/version.h"
+                             "LIBAVUTIL_VERSION_MAJOR" "libavutil" 58)
+_ninfer_ffmpeg_require_major("${FFMPEG_INCLUDE_DIR}/libswscale/version_major.h"
+                             "LIBSWSCALE_VERSION_MAJOR" "libswscale" 7)
+
+set(FFMPEG_INCLUDE_DIRS "${FFMPEG_INCLUDE_DIR}")
+set(FFMPEG_LIBRARIES
+  "${FFMPEG_AVFORMAT_LIBRARY}"
+  "${FFMPEG_AVCODEC_LIBRARY}"
+  "${FFMPEG_SWSCALE_LIBRARY}")
+if(FFMPEG_SWRESAMPLE_LIBRARY)
+  list(APPEND FFMPEG_LIBRARIES "${FFMPEG_SWRESAMPLE_LIBRARY}")
+endif()
+list(APPEND FFMPEG_LIBRARIES "${FFMPEG_AVUTIL_LIBRARY}")
+
+set(FFMPEG_LIBRARY_DIRS "")
+foreach(_library IN LISTS FFMPEG_LIBRARIES)
+  get_filename_component(_dir "${_library}" DIRECTORY)
+  list(APPEND FFMPEG_LIBRARY_DIRS "${_dir}")
+endforeach()
+if(FFMPEG_LIBRARY_DIRS)
+  list(REMOVE_DUPLICATES FFMPEG_LIBRARY_DIRS)
+endif()
+
+# The project stages FFMPEG_VCPKG_TREE/bin/*.dll next to each executable; this SDK
+# keeps its runtime DLLs in exactly that place relative to the import libraries.
+get_filename_component(_ffmpeg_lib_dir "${FFMPEG_AVCODEC_LIBRARY}" DIRECTORY)
+get_filename_component(_ffmpeg_sdk_root "${_ffmpeg_lib_dir}" DIRECTORY)
+if(EXISTS "${_ffmpeg_sdk_root}/bin")
+  set(FFMPEG_VCPKG_TREE "${_ffmpeg_sdk_root}")
+endif()
+
+mark_as_advanced(FFMPEG_INCLUDE_DIR FFMPEG_AVFORMAT_LIBRARY FFMPEG_AVCODEC_LIBRARY
+                 FFMPEG_AVUTIL_LIBRARY FFMPEG_SWSCALE_LIBRARY FFMPEG_SWRESAMPLE_LIBRARY)
